{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm --filter @tom-cat/pi-browser-runtime test",
    "test:unit": "pnpm --filter @tom-cat/pi-browser-runtime test:unit",
    "watch": "pnpm -r watch",
    "format": "prettier --write .",
    "cli:legacy": "pnpm --filter @tom-cat/pi-browser-runtime cli:legacy",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "pnpm --filter @tom-cat/pi-browser-runtime --filter mcp-extension build",
    "reload": "node scripts/legacy-action-guard.mjs reload",
    "reload:fork": "pnpm --filter @tom-cat/pi-browser-runtime build && pnpm --filter mcp-extension reload:fork",
    "reload:legacy": "pnpm --filter @tom-cat/pi-browser-runtime build && tsx playwriter/src/cli.ts serve restart && pnpm --filter mcp-extension reload:legacy",
    "agents.md": "agentsdotmd ./PLAYWRITER_AGENTS.md core.md typescript.md pnpm.md vitest.md changelog.md docs-writing.md github.md playwright.md zod.md gitchamber.md",
    "release:check-cli-version": "tsx scripts/check-extension-cli-version.ts",
    "release": "node scripts/package-extension.mjs",
    "bootstrap": "git submodule update --init && pnpm install && node playwright/utils/generate_injected.js && node playwright/packages/playwright-core/build.mjs",
    "playwright:build": "node playwright/packages/playwright-core/build.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.8"
  },
  "repository": "https://github.com/remorses/",
  "author": "remorses <beats.by.morse@gmail.com>",
  "license": "",
  "dependencies": {
    "mcp-extension": "workspace:^"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd"
    ],
    "overrides": {
      "spiceflow": "1.26.0-rsc.5"
    }
  }
}
