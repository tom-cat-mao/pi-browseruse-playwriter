{
  "manifest_version": 3,
  "name": "Pi Browser Use",
  "version": "0.0.134",
  "description": "Connect Pi Browser Use to your existing Firefox tabs for local Pi agent browser automation.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pi-browser-use@tom-cat-mao.github.io",
      "strict_min_version": "139.0"
    }
  },
  "permissions": [
    "alarms",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["userScripts"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "scripts": ["firefox-background.js"]
  },
  "action": {
    "default_title": "Pi Browser Use — local Firefox connection",
    "default_popup": "firefox-popup.html",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  }
}
