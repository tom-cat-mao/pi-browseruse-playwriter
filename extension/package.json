{
  "name": "mcp-extension",
  "version": "0.0.89",
  "description": "Playwright MCP Browser Extension",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remorses/playwriter.git"
  },
  "homepage": "https://github.com/remorses/playwriter",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Microsoft Corporation"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build-extension.mjs --fork",
    "build:fork": "node scripts/build-extension.mjs --fork",
    "build:legacy": "node scripts/build-extension.mjs --legacy",
    "reload:fork": "pnpm build:fork && echo Reload the fork extension at chrome://extensions/?id=eeklahpecooapnailfaebkjjembkjhhg",
    "reload:legacy": "pnpm build:legacy && echo Reload the legacy extension at chrome://extensions/?id=pebbngnfojnignonigcnkdilknapkgid",
    "test": "vitest run --passWithNoTests",
    "watch": "vite build --watch --config vite.config.mts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.315",
    "concurrently": "^8.2.2",
    "typescript": "^5.8.2",
    "vite": "^8.0.13",
    "vite-plugin-static-copy": "^3.1.1",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "playwriter": "workspace:@tom-cat/pi-browser-runtime@*",
    "string-dedent": "^3.0.2",
    "zustand": "^5.0.8"
  }
}
